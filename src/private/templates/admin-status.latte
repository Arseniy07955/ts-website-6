{* Offline members keep the "status-offline" class, js/script.js hides them with it *}

{define member}
    {var $isOnline = isset($client["clid"])}
    {var $isAway = $isOnline && $client["client_away"]}
    <li n:class="member, !$isOnline ? 'is-offline status-offline', $isAway ? is-away, $isOnline && !$isAway ? is-online">
        {avatar($client["client_nickname"])}
        <span class="member-text">
            <span class="member-nick">{$client["client_nickname"]}</span>
            {if $showGroup}
                <span class="member-group">
                    {if $group["iconid"]}<img src="api/geticon.php?iconid={$group["iconid"]}" alt="">{/if}
                    {$group["name"]}
                </span>
            {/if}
        </span>
        {if !$isOnline}
            <span class="member-state">{_"ADMIN_STATUS_OFFLINE"}</span>
        {elseif $isAway && isset($client["client_away_message"])}
            <span class="member-state" tabindex="0" data-toggle="tooltip" title="{$client["client_away_message"]}">{_"ADMIN_STATUS_AWAY"}</span>
        {elseif $isAway}
            <span class="member-state">{_"ADMIN_STATUS_AWAY"}</span>
        {else}
            <span class="member-state">{_"ADMIN_STATUS_ONLINE"}</span>
        {/if}
    </li>
{/define}

{* STATUS_STYLE_GROUPED or STATUS_STYLE_GROUPED_HIDE_EMPTY_GROUPS *}
{if $format === 1 || $format === 2}
    <div class="admin-status admin-status-grouped" n:attr="data-hidebydefault => $defaultHide ? 'true' : 'false'">
        {if !$data}
            <p class="side-note">{_"ADMIN_STATUS_EMPTY_STATUS"}</p>
        {/if}

        {foreach $data as $sgid => $group}
            <div class="team-group" n:if="$format !== 2 || $group['clients']">
                <h3 class="team-group-name">
                    {if $group["iconid"]}<img src="api/geticon.php?iconid={$group["iconid"]}" alt="">{/if}
                    {$group["name"]}
                </h3>

                {if $group["clients"]}
                    <ul class="member-list">
                        {foreach $group["clients"] as $client}
                            {include member, showGroup => false, client => $client, group => $group}
                        {/foreach}
                    </ul>
                {else}
                    <p class="side-note">{_"ADMIN_STATUS_EMPTY_GROUP"}</p>
                {/if}
            </div>
        {/foreach}
    </div>
{/if}

{* STATUS_STYLE_LIST and STATUS_STYLE_LIST_ONLINE_FIRST: one flat list, the group shown under each name *}
{if $format === 3 || $format === 4}
    {var $entries = []}
    {if $format === 3}
        {foreach $data as $sgid => $group}
            {foreach $group["clients"] as $client}
                {php $entries[] = ["client" => $client, "group" => $group]}
            {/foreach}
        {/foreach}
    {else}
        {var $entries = $data}
    {/if}

    <div class="admin-status admin-status-list" n:attr="data-hidebydefault => $defaultHide ? 'true' : 'false'">
        {if !$entries}
            <p class="side-note">{_"ADMIN_STATUS_EMPTY_STATUS"}</p>
        {else}
            <ul class="member-list">
                {foreach $entries as $entry}
                    {include member, showGroup => true, client => $entry["client"], group => $entry["group"]}
                {/foreach}
            </ul>
        {/if}
    </div>
{/if}
