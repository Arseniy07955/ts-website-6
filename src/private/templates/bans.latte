{extends "body.latte"}
{var $title = __get("BANS_TITLE")}
{var $navActiveIndex = 3}
{var $flushPage = true}
{var $dateUtils = Wruczek\TSWebsite\Utils\DateUtils::class}
{default $facts = null}
{default $typeCounts = null}
{default $typeLabels = null}
{default $staff = null}
{default $staffTied = 0}
{var $hasBans = is_array($banlist) && $banlist}
{* Types present in the list; the filter needs at least two of them to mean anything *}
{var $types = is_array($typeCounts) ? array_filter($typeCounts) : []}

{block content}
    {* The title section, as on the text pages. The visitor's own IP on the list comes before anything else about it *}
    <header class="section page-hero bans-hero reveal">
        <h1 class="page-title">{_"BANS_PANEL_TITLE"}</h1>
        <p class="page-sub">{_"BANS_INTRO"}</p>

        {if $ipbanned !== false}
            <div class="alert alert-danger has-icon ban-self" role="alert">
                {icon("prohibit", "alert-icon")}
                <p class="ban-self-title">{_"BANS_BANNED_ALERT_TITLE", $ipbanned["invoker"]}</p>
                {if $ipbanned["reason"] !== ""}
                    <p class="ban-self-reason">{_"BANS_BANNED_ALERT_REASON", $ipbanned["reason"]}</p>
                {/if}
                <p class="ban-self-expires">
                    {icon($ipbanned["duration"] ? "hourglass-medium" : "lock-simple", "i-sm")}
                    {if $ipbanned["duration"]}
                        {var $selfExpires = $ipbanned["created"] + $ipbanned["duration"]}
                        <span>{_"BANS_BANNED_ALERT_EXPIRES", ($selfExpires|fuzzyDateAbbr)}</span>
                    {else}
                        <span>{_"BANS_BANNED_ALERT_PERMANENT"}</span>
                    {/if}
                </p>
            </div>
        {/if}
    </header>

    {* Counted from the same list as the table below: the list in numbers and, next to them,
       who issued the most of these bans *}
    <div n:if="$facts" n:class="bans-overview, $staff ? split">
        <section n:class="stat-strip, bans-facts, $staff ? split-main, reveal" style="--i: 1" aria-label="{_"BANS_FACTS_LABEL"}">
            <dl class="cells">
                <div class="cell">
                    <dt>{icon("prohibit", "i-sm")}{_"BANS_FACT_TOTAL"}</dt>
                    <dd>{$facts["total"]}</dd>
                </div>
                <div class="cell">
                    <dt>{icon("lock-simple", "i-sm")}{_"BANS_FACT_PERMANENT"}</dt>
                    <dd>{$facts["permanent"]}</dd>
                    <dd class="cell-sub">{_"BANS_FACT_TEMPORARY", $facts["temporary"]}</dd>
                </div>
                <div class="cell">
                    <dt>{icon("hourglass-medium", "i-sm")}{_"BANS_FACT_EXPIRING"}</dt>
                    <dd>{$facts["expiringSoon"]}</dd>
                    <dd n:if="$facts['nextExpiry'] !== null" class="cell-sub">{_"BANS_FACT_NEXT", ($facts["nextExpiry"]|fuzzyDateAbbr)}</dd>
                </div>
                <div class="cell">
                    <dt>{icon("calendar-blank", "i-sm")}{_"BANS_FACT_LATEST"}</dt>
                    <dd class="bans-fact-when">{$facts["latest"]|fuzzyDateAbbr}</dd>
                    <dd class="cell-sub">{$facts["latestName"]}</dd>
                </div>
            </dl>
        </section>

        <aside n:if="$staff" class="split-side bans-staff-side reveal" style="--i: 2" aria-labelledby="bans-staff-title">
            <section class="side-block">
                <div class="side-head">
                    <h2 class="side-title" id="bans-staff-title">{_"BANS_STAFF_TITLE"}</h2>
                </div>

                <ol class="member-list bans-staff">
                    <li n:foreach="$staff as $person" class="member">
                        {avatar($person["name"])}
                        <span class="member-nick">{$person["name"]}</span>
                        <span class="bans-staff-count" aria-hidden="true">{$person["count"]}</span>
                        <span class="sr-only">{_"BANS_STAFF_COUNT", $person["count"]}</span>
                    </li>
                </ol>

                {* Others issued as many bans as the last one shown: the list is cut there, not ranked *}
                <p n:if="$staffTied" class="side-note bans-staff-tied">{_"BANS_STAFF_TIED", $staffTied}</p>
            </section>
        </aside>
    </div>

    <div class="section bans-section reveal" style="--i: {$facts ? ($staff ? 3 : 2) : 1}">
        {if $hasBans}
            <div class="bans-toolbar">
                {* Drives a DataTables row filter on data-ban-type (js/bans.js) *}
                <div n:if="count($types) > 1" class="bans-filter" role="group" aria-label="{_"BANS_FILTER_LABEL"}">
                    <button type="button" class="bans-filter-option" data-ban-filter="" aria-pressed="true">
                        {_"BANS_FILTER_ALL"}<span class="bans-filter-count">{count($banlist)}</span>
                    </button>
                    <button n:foreach="$types as $type => $count" type="button" class="bans-filter-option" data-ban-filter="{$type}" aria-pressed="false">
                        {$typeLabels[$type]}<span class="bans-filter-count">{$count}</span>
                    </button>
                </div>

                {* Drives DataTables' search (js/bans.js); its own filter and length controls are left out *}
                <div class="bans-search" role="search">
                    <label class="sr-only" for="bans-search">{_"BANS_SEARCH_LABEL"}</label>
                    {icon("magnifying-glass", "bans-search-icon")}
                    <input type="search" class="form-control" id="bans-search" aria-controls="banlist"
                           placeholder="{_"DATATABLES_PLACEHOLDER_SEARCH"}" autocomplete="off" spellcheck="false">
                    <button type="button" class="btn-reset bans-search-clear" aria-label="{_"BANS_SEARCH_CLEAR"}" hidden>
                        {icon("x")}
                    </button>
                </div>
            </div>
        {/if}

        {if $banlist === null || $banlist === false}
            {include "utils/data-problem.latte", message => __get("CANNOT_GET_DATA", "banlist")}
        {elseif empty($banlist)}
            <div class="empty-state bans-empty">
                <span class="howto-icon" aria-hidden="true">{icon("shield-check")}</span>
                <p class="empty-state-title">{_"BANS_EMPTY"}</p>
                <p>{_"BANS_EMPTY_HINT"}</p>
            </div>
        {else}
            {* Skeleton in the shape of the first page of the table, replaced once DataTables is ready *}
            <div class="bans-skeleton" id="banlist-loader" role="status">
                <span class="sr-only">{_"BANS_LOADING"}</span>

                <div class="bans-sk-row is-head" aria-hidden="true">
                    <span class="bans-sk-cell"><span class="skeleton"></span></span>
                    <span class="bans-sk-cell"><span class="skeleton"></span></span>
                    <span class="bans-sk-cell"><span class="skeleton"></span></span>
                    <span class="bans-sk-cell"><span class="skeleton"></span></span>
                    <span class="bans-sk-cell"><span class="skeleton"></span></span>
                </div>

                {* Bar widths vary from row to row like real text does *}
                {for $i = 0; $i < min(count($banlist), 10); $i++}
                    <div class="bans-sk-row" aria-hidden="true"
                         style="--w1: {45 + ($i * 23) % 40}%; --w2: {35 + ($i * 37) % 55}%; --w3: {45 + ($i * 13) % 35}%">
                        <span class="bans-sk-cell is-who">
                            <span class="skeleton bans-sk-avatar"></span>
                            <span class="bans-sk-lines"><span class="skeleton"></span><span class="skeleton"></span></span>
                        </span>
                        <span class="bans-sk-cell"><span class="skeleton"></span></span>
                        <span class="bans-sk-cell"><span class="skeleton"></span></span>
                        <span class="bans-sk-cell"><span class="skeleton"></span><span class="skeleton"></span></span>
                        <span class="bans-sk-cell"><span class="skeleton"></span></span>
                    </div>
                {/for}
            </div>

            <div class="bans-list" hidden>
                {* Shown while the table has fewer columns than it needs: rows then open to show the rest *}
                <div class="bans-tip" id="responsive-table-details-tip" hidden>
                    <div class="bans-tip-inner">
                        <p class="bans-tip-text">{icon("info", "bans-tip-icon")}<span>{_"BANS_VIEW_MORE_TIP"}</span></p>
                        <button type="button" class="btn-reset bans-tip-close" aria-label="{_"ARIA_CLOSE"}">{icon("x")}</button>
                    </div>
                </div>

                <table id="banlist" class="table bans-table dt-responsive" width="100%">
                    <thead>
                    <tr>
                        <th class="ban-col-target" data-priority="1">{_"BANS_HEADER_TARGET"}</th>
                        <th class="ban-col-reason" data-priority="3">{_"BANS_HEADER_REASON"}</th>
                        <th class="ban-col-invoker">{_"BANS_HEADER_INVOKER"}</th>
                        <th class="ban-col-date">{_"BANS_HEADER_BANDATE"}</th>
                        <th class="ban-col-expires" data-priority="2">{_"BANS_HEADER_EXPIRES"}</th>
                        {* Responsive control column: only visible while other columns are hidden *}
                        <th class="ban-col-control dtr-control"><span class="sr-only">{_"BANS_DETAILS"}</span></th>
                    </tr>
                    </thead>
                    <tbody>
                    {foreach $banlist as $ban}
                        <tr data-ban-type="{$ban["type"]}">
                            <td class="ban-target" data-filter="{$ban["filter"]}">
                                <div class="ban-who">
                                    {$ban["avatar"]}
                                    <div class="ban-who-text">{$ban["target"]}</div>
                                </div>
                            </td>
                            <td class="ban-reason">
                                {if $ban["reason"]}
                                    {$ban["reason"]}
                                {else}
                                    <span class="ban-no-reason">{_"NO_REASON_SET"|noescape}</span>
                                {/if}
                            </td>
                            <td class="ban-invoker">
                                <span class="ban-invoker-who">{avatar($ban["invoker"])}<span>{$ban["invoker"]}</span></span>
                            </td>
                            <td class="ban-date" data-order="{$ban["created"]}">
                                {* Day and time as two lines, formatted in the site language by js/bans.js *}
                                <time datetime="{date(DATE_ATOM, $ban["created"])}" data-ban-date="{$ban["created"]}">
                                    <span class="ban-day">{$dateUtils::formatDate($ban["created"])}</span>
                                    <span class="ban-time">{$dateUtils::foramtTime($ban["created"])}</span>
                                </time>
                            </td>
                            {* Sorted by when the ban ends, permanent bans last *}
                            <td class="ban-expires" data-order="{$ban["duration"] ? $ban["expires"] : PHP_INT_MAX}">
                                {if $ban["expired"]}
                                    {* Its time is up, but the server hasn't lifted it yet *}
                                    <span class="ban-ended">{_"BANS_EXPIRED", ($ban["expires"]|fuzzyDateAbbr)}</span>
                                {elseif $ban["duration"]}
                                    {$ban["expires"]|fuzzyDateAbbr}
                                {else}
                                    <span class="ban-never">{icon("lock-simple", "i-sm")}{_"BANS_NEVEREXPIRES"}</span>
                                {/if}
                            </td>
                            <td class="ban-control">
                                <button type="button" class="btn-reset ban-toggle" aria-expanded="false" aria-label="{_"BANS_SHOW_DETAILS_FOR", $ban["label"]}">
                                    {icon("caret-down")}
                                </button>
                            </td>
                        </tr>
                    {/foreach}
                    </tbody>
                </table>
            </div>

            <noscript>
                <style>
                    #banlist-loader, .bans-toolbar, .ban-control, .ban-col-control { display: none !important; }
                    .bans-list[hidden] { display: block !important; overflow-x: auto; }
                </style>
            </noscript>
        {/if}
    </div>
{/block}

{block footerbottom}
    <script>
        var DATATABLES_LANGUAGE_NAME = {_"DATATABLES_LANGUAGE_NAME"}
        var BANS_LANG = {
            searchEmpty: {_"BANS_SEARCH_EMPTY"},
            searchEmptyHint: {_"BANS_SEARCH_EMPTY_HINT"},
            searchEmptyFiltered: {_"BANS_SEARCH_EMPTY_FILTERED"},
            filterReset: {_"BANS_FILTER_RESET"},
            types: {$typeLabels ?: (object) []},
            // The strings below are in the visitor's language, not an English fallback: they replace
            // DataTables' CDN translation instead of only standing in for it
            ownStrings: {__get("BANS_TABLE_LANGUAGE") === strtolower(explode("-", $userLanguage->getLanguageCode())[0])},
            infoAll: {_"BANS_TABLE_INFO_ALL"},
            infoMatches: {_"BANS_TABLE_INFO_MATCHES"},
            // DataTables strings the page shows, in case its CDN translation can't be loaded
            table: {
                info: {_"BANS_TABLE_INFO"},
                infoEmpty: {_"BANS_TABLE_INFO_EMPTY"},
                infoFiltered: {_"BANS_TABLE_INFO_FILTERED"},
                thousands: {_"BANS_TABLE_THOUSANDS"},
                paginate: {
                    previous: {_"BANS_TABLE_PREVIOUS"},
                    next: {_"BANS_TABLE_NEXT"}
                },
                aria: {
                    sortAscending: {_"BANS_TABLE_SORT_ASC"},
                    sortDescending: {_"BANS_TABLE_SORT_DESC"}
                }
            }
        }
    </script>

    {$tplutils::includeScript("js/bans.js", true)}
{/block}
